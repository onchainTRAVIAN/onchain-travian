{
  "name": "onchain-travian",
  "version": "0.20.6",
  "private": true,
  "description": "Classic Travian 3.6-style browser strategy game with an onchain economy - build, raid, conquer",
  "license": "UNLICENSED",
  "author": "onchainTRAVIAN",
  "homepage": "https://github.com/onchainTRAVIAN/onchain-travian#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onchainTRAVIAN/onchain-travian.git"
  },
  "bugs": {
    "url": "https://github.com/onchainTRAVIAN/onchain-travian/issues"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/web/public','dist/web/public',{recursive:true})\"",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "chain:deploy": "tsx scripts/deploy-local.ts",
    "deploy": "railway up --service game --ci"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "sharp": "^0.35.5",
    "viem": "^2.57.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
