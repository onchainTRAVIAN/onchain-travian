# Server
PORT=3000
NODE_ENV=development
# Long random string; used to sign nothing secret yet but reserved for future HMACs
SESSION_SECRET=change-me-to-a-long-random-string
# Public address of the game (other hosts redirect here; wallet sign-in is bound to it). Empty = any host (dev)
PUBLIC_URL=
# Comma-separated wallet addresses that become admins when they join or log in
ADMIN_WALLETS=
# Gzipped database snapshots next to the db (backups/), every BACKUP_HOURS (0 = off), newest BACKUP_KEEP kept
BACKUP_HOURS=6
BACKUP_KEEP=8
# SQLite file path
DATABASE_PATH=./data/game.db

# World
WORLD_NAME=onchainTRAVIAN
# Production and build/training speed multiplier (1 = normal, 3 = fast server)
WORLD_SPEED=1
# Merchants per Marketplace level (1 = classic)
MERCHANT_MULTIPLIER=1
# Troop movement speed multiplier
TROOP_SPEED=1
# Map spans -MAP_RADIUS..MAP_RADIUS on both axes
MAP_RADIUS=50
# Hours of beginner protection for new players
PROTECTION_HOURS=72
# Reports older than this many days are deleted; each player keeps at most REPORT_CAP
REPORT_DAYS=14
REPORT_CAP=1000

# Premium
# Credits per hour of news-ticker time, and how many messages can share one hour
TICKER_PRICE_PER_HOUR=20
TICKER_MAX_PER_HOUR=3
# Free credits for new players
STARTER_CREDITS=0

# Crypto (leave empty to switch crypto features off)
CHAIN_ID=31337
CHAIN_NAME=Local Anvil
RPC_URL=
PAYMENTS_ADDRESS=
TOKEN_ADDRESS=
TOKEN_SYMBOL=REALM
TOKEN_DECIMALS=18
# 1 ETH buys this many credits
# ETH payments follow the dollar Gold packages at the live ETH/USD price; this is only the fallback price
ETH_USD=3000
# 1 token buys this many credits, plus TOKEN_BONUS (0.2 = +20%)
CREDITS_PER_TOKEN=1
TOKEN_BONUS=0.2
CONFIRMATIONS=2
INDEXER_START_BLOCK=0
INDEXER_INTERVAL_SECONDS=15
HOLDER_SNAPSHOT_HOURS=6
HOLDER_MIN_SNAPSHOTS=4
# kie.ai image generation for scripts/art (local only)
KIE_API_KEY=

# Telegram bot that hands out the X posts (scripts/social/tgbot.py, local only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
